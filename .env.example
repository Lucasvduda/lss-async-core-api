APP_NAME=LSS Async Core API
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Use SQLite for local demo without Docker:
DATABASE_URL=sqlite+aiosqlite:///./async_core.db
# Postgres (docker-compose):
# DATABASE_URL=postgresql+asyncpg://lss:lss@localhost:5432/async_core
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=*